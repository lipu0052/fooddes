{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",                  // Changed: now the root is the backend folder itself
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "server.ts",
    "app.ts",
    "data/**/*.ts",
    "types/**/*.ts",
    "services/**/*.ts",
    "routes/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}